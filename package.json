{
  "name": "triforge",
  "displayName": "Triforge: TRITON Flood Inundation Simulation and Analysis",
  "description": "Triforge: a VS Code extension for the TRITON flood inundation simulation framework.",
  "icon": "media/triforge-marketplace.png",
  "version": "0.1.0",
  "publisher": "triton-team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grnydawn/triforge-extension-agenticai4hpc"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Triforge runs project-defined build, run, and docker commands from workspace configuration; these are only safe in a trusted workspace."
    }
  },
  "contributes": {
    "languageModelTools": [
      {
        "name": "triforge_configure_solver",
        "displayName": "Configure TRITON solver",
        "modelDescription": "Render a TRITON execution .cfg for the ACTIVE Triforge project. Every field defaults from the active project; pass `project` to override specific fields (e.g. { \"sim_duration\": 7200 }). Returns the rendered .cfg text, and writes it to `outPath` if given. Requires an active Triforge project.",
        "toolReferenceName": "configureSolver",
        "canBeReferencedInPrompt": true,
        "icon": "$(gear)",
        "tags": [
          "triforge"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "project": {
              "type": "object",
              "description": "Config field overrides merged over the active project, e.g. { \"sim_duration\": 7200 }.",
              "additionalProperties": true
            },
            "templatePath": {
              "type": "string",
              "description": "Override the execution template path (defaults to the bundled template)."
            },
            "outPath": {
              "type": "string",
              "description": "If set, write the rendered .cfg to this path."
            }
          }
        }
      },
      {
        "name": "triforge_run_local",
        "displayName": "Run TRITON locally",
        "modelDescription": "Run a TRITON simulation locally for the ACTIVE Triforge project: writes triton_execution.cfg into the run directory, then executes `runCommand` there. Pauses for the user to confirm before running. Returns the exit code and captured output. Requires an active Triforge project.",
        "toolReferenceName": "runLocal",
        "canBeReferencedInPrompt": true,
        "icon": "$(play)",
        "tags": [
          "triforge"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "runCommand": {
              "type": "string",
              "description": "The command to run in the run directory, e.g. 'mpirun -np 4 ./triton'."
            },
            "project": {
              "type": "object",
              "description": "Config field overrides merged over the active project.",
              "additionalProperties": true
            },
            "runDir": {
              "type": "string",
              "description": "Directory to run in (defaults to <activeProject>/build)."
            },
            "templatePath": {
              "type": "string",
              "description": "Override the execution template path."
            }
          },
          "required": [
            "runCommand"
          ]
        }
      },
      {
        "name": "triforge_export_tfp",
        "displayName": "Export Triforge project (.tfp)",
        "modelDescription": "Package the ACTIVE Triforge project (its config.json + input files, and optionally outputs) into a single portable .tfp archive that can be moved to another machine (e.g. an HPC system) and re-imported with triforge_import_tfp. `projectDir` defaults to the active project folder. Requires an active Triforge project.",
        "toolReferenceName": "exportTfp",
        "canBeReferencedInPrompt": true,
        "icon": "$(package)",
        "tags": [
          "triforge"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "outPath": {
              "type": "string",
              "description": "Path to write the .tfp archive, e.g. 'my-run.tfp'. Relative paths resolve against the active project folder."
            },
            "projectDir": {
              "type": "string",
              "description": "Project folder to package (defaults to the active project folder)."
            },
            "includeOutputs": {
              "type": "boolean",
              "description": "Include the project's output/ files in the archive (default false)."
            }
          },
          "required": [
            "outPath"
          ]
        }
      },
      {
        "name": "triforge_import_tfp",
        "displayName": "Import Triforge project (.tfp)",
        "modelDescription": "Extract a portable .tfp archive into a destination folder: validates the archive, refuses any entry that escapes the folder, writes the project files, and re-localizes config.json to this machine. Pauses for the user to confirm before writing. Relative paths resolve against the active project folder. Does not render the run .cfg (use triforge_configure_solver). Requires an active Triforge project.",
        "toolReferenceName": "importTfp",
        "canBeReferencedInPrompt": true,
        "icon": "$(archive)",
        "tags": [
          "triforge"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "archivePath": {
              "type": "string",
              "description": "Path to the .tfp archive to extract."
            },
            "destRoot": {
              "type": "string",
              "description": "Destination folder to extract the project into."
            }
          },
          "required": [
            "archivePath",
            "destRoot"
          ]
        }
      },
      {
        "name": "triforge_create_water_source",
        "displayName": "Create a water source",
        "modelDescription": "Write TRITON streamflow inputs (.src + .hyg) for the ACTIVE Triforge project and wire num_sources/src_loc_file/hydrograph_filename. `locations` are UTM {x,y} or {lat,lng}; `hydrographs` is a number[][] (one array per source). Pauses for the user to confirm. Requires an active Triforge project.",
        "toolReferenceName": "createWaterSource",
        "canBeReferencedInPrompt": true,
        "icon": "$(location)",
        "tags": [
          "triforge"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "locations": {
              "type": "array",
              "description": "Source points: {x,y} UTM or {lat,lng}.",
              "items": {
                "type": "object"
              }
            },
            "hydrographs": {
              "type": "array",
              "description": "Discharge per source: number[][].",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "projectDir": {
              "type": "string",
              "description": "Project folder (defaults to the active project)."
            }
          },
          "required": [
            "locations",
            "hydrographs"
          ]
        }
      },
      {
        "name": "triforge_generate_dem",
        "displayName": "Generate DEM (OpenTopography)",
        "modelDescription": "Download an elevation model matching the ACTIVE project's simulation area from OpenTopography and write a TRITON .asc into the project input folder. Requires the TRIFORGE_OPENTOPOGRAPHY_API_KEY environment variable. Pauses for the user to confirm. Requires an active Triforge project.",
        "toolReferenceName": "generateDem",
        "canBeReferencedInPrompt": true,
        "icon": "$(cloud-download)",
        "tags": [
          "triforge"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "description": "DEM source (default OpenTopography → SRTMGL1)."
            },
            "projectDir": {
              "type": "string",
              "description": "Project folder (defaults to the active project)."
            },
            "outPath": {
              "type": "string",
              "description": "Where to write the .asc (defaults to <project>/input/<name>.asc)."
            }
          }
        }
      },
      {
        "name": "triforge_animate_gif",
        "displayName": "Animate flood output (GIF)",
        "modelDescription": "Render a colormap GIF of a TRITON output variable (default H, water depth) from the ACTIVE project's run output (no basemap). Optional variable (H/QX/QY), colormap (default Rainbow), fps (default 5), outputDir, outPath. Requires an active Triforge project with output.",
        "toolReferenceName": "animateGif",
        "canBeReferencedInPrompt": true,
        "icon": "$(play-circle)",
        "tags": [
          "triforge"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "variable": {
              "type": "string",
              "description": "Output variable prefix, e.g. H (water depth), QX, QY. Default H."
            },
            "colormap": {
              "type": "string",
              "description": "Colormap name (Rainbow, Viridis, Blues, …)."
            },
            "fps": {
              "type": "number",
              "description": "Frames per second (default 5)."
            },
            "outputDir": {
              "type": "string",
              "description": "Output folder (defaults to <project>/output)."
            },
            "projectDir": {
              "type": "string",
              "description": "Project folder (defaults to the active project)."
            },
            "outPath": {
              "type": "string",
              "description": "GIF path (defaults to <project>/<name>.gif)."
            }
          }
        }
      },
      {
        "name": "triforge_diagnose_project",
        "displayName": "Diagnose TRITON project",
        "modelDescription": "Statically diagnose a TRITON deck (.cfg + input files) and return ranked, evidence-backed findings for a runs-but-broken workflow: unsubstituted template placeholders, missing inputs, runoff/source count vs hydrograph mismatches, grid-size mismatches, all-zero forcing, and coverage/parameter sanity. Targets the active Triforge project by default, OR pass an explicit projectDir (a path to any TRITON project folder) to diagnose a foreign/hand-built deck with no active project. Read-only. Optional cfgPath and expectations (inputs, numRunoffs, numSources, simDurationSec, forcingRange {min,max}) verify user-declared invariants. Generic to any TRITON workflow.",
        "toolReferenceName": "diagnoseProject",
        "canBeReferencedInPrompt": true,
        "icon": "$(search)",
        "tags": [
          "triforge"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": {
              "type": "string",
              "description": "Project folder (defaults to the active project)."
            },
            "cfgPath": {
              "type": "string",
              "description": "Path to the TRITON .cfg (defaults to triton_execution.cfg or the single *.cfg in the project)."
            },
            "expectations": {
              "type": "object",
              "description": "Optional user-declared invariants: inputs (string[]), numRunoffs, numSources, simDurationSec, forcingRange {min,max}."
            }
          }
        }
      },
      {
        "name": "triforge_explain_triton",
        "displayName": "Explain TRITON",
        "modelDescription": "Answer TRITON/Triforge domain questions from a curated, vetted knowledge base: file formats (.bin/.asc/DEM/runoff-map/output .out), deck (.cfg) structure and path resolution, output variables (H=depth, QX/QY=discharge, MH=max height), grid conventions, common failure modes, and the Triforge workflow. Call before answering any TRITON domain question. Pass topic (a keyword or article id, e.g. 'file-formats', 'runoff map', 'MH') to read an article; omit topic to list topics. Read-only reference.",
        "toolReferenceName": "explainTriton",
        "canBeReferencedInPrompt": true,
        "icon": "$(book)",
        "tags": [
          "triforge"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "description": "A keyword or article id to look up (e.g. 'file-formats', 'runoff map', 'MH'). Omit to list available topics."
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Triforge",
      "properties": {
        "triforge.python.interpreterPath": {
          "type": "string",
          "default": "python3",
          "markdownDescription": "Path to the Python interpreter used to run the bundled DEM fetch script (`fetch_dem.py`). Defaults to `python3` on the PATH; set an absolute path (e.g. a virtualenv) if `python3` is unavailable."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "triforge-activitybar",
          "title": "Triforge",
          "icon": "media/triforge-icon.svg"
        }
      ]
    },
    "views": {
      "triforge-activitybar": [
        {
          "id": "triforge-projects",
          "name": "Projects",
          "visibility": "visible"
        },
        {
          "id": "triforge-simulations",
          "name": "Simulations",
          "visibility": "visible"
        },
        {
          "id": "triforge-properties",
          "name": "Properties",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "triforge.createProject",
        "title": "Create New Project",
        "icon": "$(add)"
      },
      {
        "command": "triforge.openExistingProject",
        "title": "Open Existing Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "triforge.openSettings",
        "title": "Triforge Global Settings"
      },
      {
        "command": "triforge.openHome",
        "title": "Open Triforge Home (AI Catalog)",
        "category": "Triforge",
        "icon": "$(home)"
      },
      {
        "command": "triforge.loadAnimation",
        "title": "Animate",
        "category": "Triforge"
      },
      {
        "command": "triforge.openMap",
        "title": "Open Map",
        "category": "Triforge",
        "icon": "$(map)"
      },
      {
        "command": "triforge.removeProject",
        "title": "Remove Project"
      },
      {
        "command": "triforge.exportProject",
        "title": "Export Project...",
        "category": "Triforge",
        "icon": "$(export)"
      },
      {
        "command": "triforge.importProject",
        "title": "Import Project...",
        "category": "Triforge",
        "icon": "$(desktop-download)"
      },
      {
        "command": "triforge.simulations.sort",
        "title": "Sort Folder...",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "triforge.simulations.filter",
        "title": "Filter Folder...",
        "icon": "$(filter)"
      },
      {
        "command": "triforge.pickSimulationArea",
        "title": "Pick Simulation Area...",
        "icon": "$(map)"
      },
      {
        "command": "triforge.resetSettings",
        "title": "Triforge: Reset Settings"
      },
      {
        "command": "triforge.addInput",
        "title": "Add Input",
        "icon": "$(add)"
      },
      {
        "command": "triforge.openInputFolder",
        "title": "Open Input Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "triforge.addOutput",
        "title": "Add Output",
