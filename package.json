    "menus": {
      "commandPalette": [
        {
          "command": "triforge.openProject",
          "when": "false"
        },
        {
          "command": "triforge.selectDem",
          "when": "false"
        },
        {
          "command": "triforge.simulations.click",
          "when": "false"
        },
        {
          "command": "triforge.openDynamicInputGenerator",
          "when": "false"
        },
        {
          "command": "triforge.addInput",
          "when": "false"
        },
        {
          "command": "triforge.addOutput",
          "when": "false"
        },
        {
          "command": "triforge.addOutputToCategory",
          "when": "false"
        },
        {
          "command": "triforge.removeOutputCategory",
          "when": "false"
        },
        {
          "command": "triforge.removeOutputItem",
          "when": "false"
        },
        {
          "command": "triforge.removeInput",
          "when": "false"
        },
        {
          "command": "triforge.removeProject",
          "when": "false"
        },
        {
          "command": "triforge.exportProject",
          "when": "false"
        },
        {
          "command": "triforge.deleteDem",
          "when": "false"
        },
        {
          "command": "triforge.openInputFolder",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "triforge.createProject",
          "when": "view == triforge-projects",
          "group": "navigation@1"
        },
        {
          "command": "triforge.openExistingProject",
          "when": "view == triforge-projects",
          "group": "navigation@2"
        },
        {
          "command": "triforge.importProject",
          "when": "view == triforge-projects",
          "group": "navigation@3"
        },
        {
          "command": "triforge.openSettings",
          "when": "view == triforge-simulations"
        },
        {
          "command": "triforge.openSettings",
          "when": "view == triforge-properties"
        },
        {
          "command": "triforge.openHome",
          "when": "view == triforge-projects && !triforge:homeSeated",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "triforge.addInput",
          "when": "view == triforge-simulations && viewItem == staticInputNode",
          "group": "inline"
        },
        {
          "command": "triforge.openInputFolder",
          "when": "view == triforge-simulations && viewItem == staticInputNode",
          "group": "inline"
        },
        {
          "command": "triforge.addOutput",
          "when": "view == triforge-simulations && viewItem == outputGroup",
          "group": "inline"
        },
        {
          "command": "triforge.addOutputToCategory",
          "when": "view == triforge-simulations && viewItem == outputCategory",
          "group": "inline"
        },
        {
          "command": "triforge.simulations.filter",
          "when": "view == triforge-simulations && viewItem == outputCategory",
          "group": "inline"
        },
        {
          "command": "triforge.simulations.sort",
          "when": "view == triforge-simulations && viewItem == outputCategory",
          "group": "inline"
        },
        {
          "command": "triforge.removeOutputCategory",
          "when": "view == triforge-simulations && viewItem == outputCategory",
          "group": "inline"
        },
        {
          "command": "triforge.loadAnimation",
          "when": "view == triforge-simulations && viewItem == outputCategory",
          "group": "1_modification"
        },
        {
          "command": "triforge.loadAnimation",
          "when": "view == triforge-simulations && viewItem == outputConfigItem",
          "group": "1_modification"
        },
        {
          "command": "triforge.removeOutputItem",
          "when": "view == triforge-simulations && viewItem == outputConfigItem",
          "group": "inline"
        },
        {
          "command": "triforge.removeOutputItem",
          "when": "view == triforge-simulations && viewItem == outputConfigItem"
        },
        {
          "command": "triforge.deleteDem",
          "when": "view == triforge-simulations && viewItem == demNode"
        },
        {
          "command": "triforge.removeProject",
          "when": "view == triforge-projects && viewItem == triforgeProject"
        },
        {
          "command": "triforge.exportProject",
          "when": "view == triforge-projects && viewItem == triforgeProject"
        },
        {
          "command": "triforge.simulations.sort",
          "when": "view == triforge-simulations && viewItem == folderRecursive",
          "group": "inline"
        },
        {
          "command": "triforge.simulations.filter",
          "when": "view == triforge-simulations && viewItem == folderRecursive",
          "group": "inline"
        },
        {
          "command": "triforge.simulations.sort",
          "when": "view == triforge-simulations && viewItem == folderRecursive"
        },
        {
          "command": "triforge.simulations.filter",
          "when": "view == triforge-simulations && viewItem == folderRecursive"
        },
        {
          "command": "triforge.loadAnimation",
          "when": "view == triforge-simulations && (viewItem == file || viewItem == folderRecursive || viewItem == vrtFile)"
        },
        {
          "command": "triforge.removeInput",
          "when": "view == triforge-simulations && (viewItem == demNode || viewItem == initHNode || viewItem == initQxQyNode || viewItem == streamflowNode)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package && npm run build:webview",
    "compile": "webpack --mode none",
    "watch": "webpack --mode none --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsce:package": "vsce package",
    "build:webview": "webpack --config webpack.webview.config.js",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src",
    "test:unit": "cross-env TS_NODE_TRANSPILE_ONLY=true TS_NODE_PROJECT=tsconfig.test.json node test/run-unit.js",
    "test:hpc": "python3 -m unittest discover -s scripts/hpc -p 'test_*.py'",
    "docs": "node scripts/docs-build.js",
    "docs:clean": "node scripts/docs-build.js --clean",
    "mcp:build": "node scripts/mcp/build.mjs",
    "mcp:start": "node dist/mcp/server.cjs",
    "mcp:smoke": "npm run mcp:build && node scripts/mcp/smoke.mjs",
    "pretest:e2e": "npm run compile && npm run build:webview",
    "test:e2e": "extest setup-and-run \"test/e2e/suites/**/*.e2e.test.ts\" --code_version 1.90.0 --type stable --mocha_config test/.mocharc-e2e.js -i --code_settings test/extester-settings.json",
    "pretest:e2e:run": "npm run compile && npm run build:webview",
    "test:e2e:run": "extest setup-and-run \"${E2E_GLOB:-test/e2e/suites/**/*.e2e.test.ts}\" --code_version 1.90.0 --type stable --mocha_config test/.mocharc-e2e.js -i --code_settings test/extester-settings.json",
    "test:all": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e",
    "test": "npm run test:all",
    "test:fast": "npm run typecheck && npm run lint && npm run test:unit",
    "hooks:install": "git config core.hooksPath scripts/hooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.2.5",
    "@types/proj4": "^2.5.6",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "chai": "^4.5.0",
    "copy-webpack-plugin": "^13.0.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
